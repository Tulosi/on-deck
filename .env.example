# ── Frontend (copy to .env.local) ─────────────────────────────────────────
# These two are public by design; Row Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only needed if the GitHub repo is not called "on-deck"
# VITE_BASE=/on-deck/

# ── Server secrets — NOT for .env.local ───────────────────────────────────
# Set these on Supabase:  supabase secrets set NAME=value
# TMDB_READ_TOKEN=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# OMDB_API_KEY=
# HARDCOVER_TOKEN=
# GGDEALS_API_KEY=
